// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String @id @default(cuid())
  name     String @default("")
  email    String @unique @default("")
  password String
  posts    Post[] @relation("Post_author")
}

model Author {
  id          String @id @default(cuid())
  name        String @default("")
  bio         String @default("")
  workspaceId String @default("")
  siteId      String @default("")
  posts       Post[] @relation("Post_authorRef")

  @@index([workspaceId])
  @@index([siteId])
}

model Category {
  id          String @id @default(cuid())
  name        String @default("")
  slug        String @unique @default("")
  workspaceId String @default("")
  siteId      String @default("")
  posts       Post[] @relation("Post_category")

  @@index([workspaceId])
  @@index([siteId])
}

model Tag {
  id          String @id @default(cuid())
  name        String @default("")
  slug        String @unique @default("")
  workspaceId String @default("")
  siteId      String @default("")
  posts       Post[] @relation("Post_tags")

  @@index([workspaceId])
  @@index([siteId])
}

model MediaRef {
  id          String  @id @default(cuid())
  title       String  @default("")
  url         String  @default("")
  kind        String? @default("image")
  workspaceId String  @default("")
  siteId      String  @default("")

  @@index([workspaceId])
  @@index([siteId])
}

model Post {
  id          String    @id @default(cuid())
  title       String    @default("")
  slug        String    @default("")
  excerpt     String    @default("")
  status      String?   @default("draft")
  workspaceId String    @default("")
  siteId      String    @default("")
  publishedAt DateTime?
  content     String    @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  author      User?     @relation("Post_author", fields: [authorId], references: [id])
  authorId    String?   @map("author")
  authorRef   Author?   @relation("Post_authorRef", fields: [authorRefId], references: [id])
  authorRefId String?   @map("authorRef")
  category    Category? @relation("Post_category", fields: [categoryId], references: [id])
  categoryId  String?   @map("category")
  tags        Tag[]     @relation("Post_tags")
  coverUrl    String    @default("")

  @@index([slug])
  @@index([workspaceId])
  @@index([siteId])
  @@index([authorId])
  @@index([authorRefId])
  @@index([categoryId])
}
